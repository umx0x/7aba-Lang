
display "Give Me The Number of Rows : "
input rows
display "Give Me The Number of Columns : "
input cols
matrix grid rows cols

row = 0
while row < rows {
    col = 0
    while col < cols {
        display "Enter value for [" row " " col "] : "
        input value
        matrix_set grid row col value
        col = col + 1
    }
    row = row + 1
}



display grid