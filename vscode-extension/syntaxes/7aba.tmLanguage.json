{
  "scopeName": "source.7aba",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#actionDefinition" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#functionCalls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.7aba",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.7aba",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.7aba",
          "match": "\\\\."
        }
      ]
    },
    "actionDefinition": {
      "name": "meta.function.definition.7aba",
      "match": "\\b(action)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.action.7aba" },
        "2": { "name": "entity.name.function.7aba" }
      }
    },
    "keywords": {
      "name": "keyword.control.7aba",
      "match": "\\b(?:while|repeat|when|otherwise|empty)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.7aba",
      "match": "\\b(?:display|input|list|pile|push|pop|len|save|load|matrix|matrix_set|matrix_get|queue|enqueue|dequeue|peek|file_display|file_read|file_write)\\b"
    },
    "functionCalls": {
      "name": "entity.name.function.call.7aba",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.7aba" }
      }
    },
    "numbers": {
      "name": "constant.numeric.integer.7aba",
      "match": "\\b[0-9]+\\b"
    },
    "operators": {
      "name": "keyword.operator.7aba",
      "match": "(?:==|!=|<=|>=|[+*/=<>&!-])"
    },
    "punctuation": {
      "name": "punctuation.section.7aba",
      "match": "[{}()\\[\\],]"
    }
  }
}
